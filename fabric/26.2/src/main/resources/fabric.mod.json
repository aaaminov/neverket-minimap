      "dev.neverket.minimap.fabric26.NeverketMinimapFabric26"
    ],
    "modmenu": [
      "dev.neverket.minimap.fabric26.NeverketMinimapModMenu26"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
